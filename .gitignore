
# Initialize git
git init

# Create .gitignore
echo "
node_modules/
dist/
.DS_Store
*.log
.env
coverage/
" > .gitignore

# Add files
git add .
git commit -m "Initial commit: React Offline Sync Hook v1.0.1"

# Push to GitHub
git remote add origin https://github.com/gohel-biren1111/react-offline-sync-hook.git
git branch -M main
git push -u origin main